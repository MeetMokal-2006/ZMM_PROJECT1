@Metadata.layer: #CORE

annotate entity ZC_MM_MANAGER_EXPENSEITEM
    with
{
  /* Expense Type ID */
  @UI.lineItem: [
    { position: 10, importance: #HIGH, label: 'Expense Type ID' }
  ]
  @UI.identification: [
    { position: 10, label: 'Expense Type ID' }
  ]
  ExpenseTypeId;

  /* Expense Type Name */
  @UI.lineItem: [
    { position: 20, importance: #HIGH, label: 'Expense Type' }
  ]
  @UI.identification: [
    { position: 20, label: 'Expense Type' }
  ]
  ExpenseTypeName;

  /* Expense Date */
  @UI.lineItem: [
    { position: 30, label: 'Expense Date' }
  ]
  @UI.identification: [
    { position: 30, label: 'Expense Date' }
  ]
  ExpenseDate;

  /* Amount */
  @UI.lineItem: [
    { position: 40, importance: #HIGH, label: 'Amount' }
  ]
  @UI.identification: [
    { position: 40, label: 'Amount' }
  ]
  Amount;

  /* Description */
  @UI.lineItem: [
    { position: 50, importance: #HIGH, label: 'Description' }
  ]
  @UI.identification: [
    { position: 50, label: 'Description' }
  ]
  Description;


  @UI.hidden: true
  CreatedBy;

  @UI.hidden: true
  CreatedAt;

  @UI.hidden: true
  LastChangedBy;

  @UI.hidden: true
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}